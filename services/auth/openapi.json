{
  "openapi": "3.1.0",
  "info": { "title": "Auth Service", "version": "1.0.0" },
  "paths": {
    "/users/{id}": {
      "get": {
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/UserResponse" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "UserResponse": {
        "description": "User profile payload",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/User" } }
        }
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "email": { "type": "string" }
        }
      }
    }
  }
}